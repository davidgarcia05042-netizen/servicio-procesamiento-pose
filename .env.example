# Copiar a .env y completar. .env NO se sube a git (ver .gitignore).

# --- Entorno ---
# development | production
# Con production, el servicio EXIGE que Redis vaya por TLS (rediss://) y se
# niega a arrancar si no lo está.
ENVIRONMENT=development

# --- Cola (Celery + Redis) ---
# En local: redis:// (sin TLS) está bien, el tráfico no sale de la máquina.
# En Render: pegar la URL de la Key Value tal cual. Con ENVIRONMENT=production
# se acepta redis:// SOLO si el host es la dirección interna de Render (tipo
# "red-xxxxx", sin dominio), porque ese tráfico va por su red privada. Para
# cualquier otro host se exige rediss://.
REDIS_BROKER_URL=redis://localhost:6379/0
REDIS_BACKEND_URL=redis://localhost:6379/1
# Contraseña del Redis local. docker-compose la usa para --requirepass y el
# servicio la inyecta en las URLs de arriba. Sin esto, docker compose no
# levanta Redis.
REDIS_PASSWORD=cambiar-por-una-contrasena-larga

# --- PostgreSQL ---
# Driver asyncpg: postgresql+asyncpg://usuario:password@host:puerto/base
# Puerto 5433, no 5432: el contenedor del docker-compose se publica en 5433
# para no chocar con una instalación nativa de PostgreSQL en la máquina.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/pose_service
# Conexiones por proceso (pool + extra en un pico). En Render van en 2 y 1
# (ver README, "Costos" y deploy/render/render.yaml).
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10

# --- Almacenamiento del video (Render) ---
# "postgres" (por defecto, el de producción): el video espera en la misma base
# que los jobs, en la tabla `videos`. No hay nada más que configurar.
# STORAGE_BACKEND=postgres
#
# Alternativas (ver README):
#   "supabase": la URL del proyecto y la secret key (sb_secret_...), que se
#   salta RLS: nunca en un cliente ni en el repositorio.
# STORAGE_BACKEND=supabase
# SUPABASE_URL=https://<ref>.supabase.co
# SUPABASE_SECRET_KEY=
# SUPABASE_STORAGE_BUCKET=videos
#   "firebase": el JSON de la cuenta de servicio y el bucket (exige plan Blaze).
# STORAGE_BACKEND=firebase
# FIREBASE_CREDENTIALS_PATH=./firebase-credentials.json
# FIREBASE_STORAGE_BUCKET=mi-proyecto.appspot.com
# Emulador local de almacenamiento, SOLO para desarrollo. Con
# ENVIRONMENT=production el servicio no arranca si está.
# STORAGE_EMULATOR_HOST=http://localhost:4443

# --- Autenticación con la plataforma cliente (HMAC, no cuentas de usuario) ---
# Secreto compartido con la plataforma de telefisioterapia. La plataforma firma
# el cuerpo del request y este servicio verifica la firma.
HMAC_SECRET=cambiar-por-un-secreto-largo-y-aleatorio
# Ventana de tolerancia del timestamp, en segundos (anti-replay)
HMAC_MAX_SKEW_SECONDS=300
# false = modo advertencia: una firma ausente o inválida se registra en el log
#         pero la solicitud se procesa igual.
# true  = modo estricto: se rechaza con 401.
# Arranca en false porque la plataforma todavía no firma de su lado. Cambiar a
# true en cuanto confirmen que ya envían X-Signature.
HMAC_ENFORCE=false

# --- A dónde puede enviarse el callback ---
# Lista separada por comas de los hosts a los que se acepta enviar resultados.
# El resultsEndpoint lo elige quien hace la solicitud: sin lista, el servicio
# manda peticiones firmadas a donde le digan y las reintenta durante horas.
# Vacía = sin lista (solo se bloquean direcciones internas y, en producción,
# http). EN PRODUCCIÓN HAY QUE LLENARLA: es el único control que de verdad
# cierra esto.
# Un host puesto acá se acepta tal cual, incluso interno: así se apunta a una
# máquina local para probar (ej. CALLBACK_ALLOWED_HOSTS=localhost,127.0.0.1).
CALLBACK_ALLOWED_HOSTS=

# --- Validación de video ---
MAX_VIDEO_SIZE_MB=200

# --- Límite de tasa del POST /video/ ---
# Sintaxis de slowapi: "<n>/<periodo>", ej. 10/minute, 100/hour
RATE_LIMIT_VIDEO=10/minute

# --- Observabilidad ---
# CRITICAL | ERROR | WARNING | INFO | DEBUG. Vale para la API y para el worker:
# el --loglevel de Celery queda ignorado a propósito, para poder cambiar el
# nivel en producción sin volver a desplegar. Un valor mal escrito impide el
# arranque en vez de caer en silencio al nivel por defecto.
LOG_LEVEL=INFO
# Cada cuánto el worker emite el resumen de estado, y qué ventana cubre. La
# ventana va más ancha que el intervalo para que dos resúmenes consecutivos se
# solapen y un retraso de Beat no deje un hueco sin reportar.
STATUS_REPORT_INTERVAL_MINUTES=15
STATUS_REPORT_WINDOW_MINUTES=60
# Dónde guarda Celery Beat cuándo corrió cada tarea periódica. En local, el
# valor por defecto funciona. En el contenedor NO: corre sin root y /app es de
# root, así que Beat moriría con "Permission denied" -- por eso el Dockerfile
# apunta esta variable a un directorio escribible.
# BEAT_SCHEDULE_PATH=celerybeat-schedule

# --- Retención de datos (Ley 1581 de 2012) ---
# Días que se conservan los datos personales de un job ya cerrado antes de
# minimizarlo: se borran los ángulos, la ruta del video y el resultsEndpoint, y
# se conserva lo que no identifica a nadie. El video del almacenamiento externo
# se borra antes, en cuanto el job queda cerrado.
# El plazo NO es una decisión técnica: confirmar con quien responda por el
# tratamiento de datos.
DATA_RETENTION_DAYS=30
RETENTION_SCAN_INTERVAL_HOURS=24
RETENTION_BATCH_SIZE=500

# --- Reintentos de callbacks ---
# La hora de cada reintento vive en PostgreSQL (columna callback_next_attempt_at)
# y el despachador encola los que ya vencieron cada tantos segundos.
CALLBACK_DISPATCH_INTERVAL_SECONDS=10
# Pausa entre rondas de 9 intentos, y hasta cuándo se insiste desde que entró
# el job. Pasada la ventana, el aviso queda en "exhausted".
CALLBACK_RETRY_INTERVAL_MINUTES=60
CALLBACK_RETRY_WINDOW_HOURS=72
# Cuánto tiene que llevar un aviso en "pending" para darlo por perdido (su
# tarea desapareció). TIENE QUE SUPERAR el visibility_timeout del broker (1 h).
CALLBACK_STALE_PENDING_HOURS=3
CALLBACK_RETRY_BATCH_SIZE=100

# --- Modelo de pose por defecto ---
# Opciones validadas en entorno-pruebas: mediapipe_heavy, mediapipe_lite
POSE_MODEL=mediapipe_heavy

# --- Google Cloud (ver README, "Despliegue en Google Cloud") ---
# Bucket de Cloud Storage. Sin credenciales: en Cloud Run se usa la cuenta de
# servicio, y en local `gcloud auth application-default login`.
# GCS_BUCKET=<proyecto>-videos
# Cola: Cloud Tasks hacia el worker en Cloud Run. En producción son
# obligatorias. Cloud Scheduler firma con la misma cuenta.
# GCP_PROJECT=<proyecto>
# GCP_REGION=us-central1
# WORKER_URL=https://pose-worker-<...>.run.app
# TASKS_SERVICE_ACCOUNT=pose-tasks@<proyecto>.iam.gserviceaccount.com
# Cloud SQL por el socket que monta Cloud Run (sin sslmode: el socket no sale
# de la máquina y el proxy de Cloud SQL cifra el resto):
# DATABASE_URL=postgresql+asyncpg://pose:<clave>@/pose_service?host=/cloudsql/<proyecto>:us-central1:pose-db
